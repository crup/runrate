{
  "name": "@crup/runrate",
  "version": "0.1.0",
  "description": "Realtime token, cache, and cost telemetry for AI coding agents.",
  "type": "module",
  "license": "MIT",
  "author": "Rajender Joshi <connect@rajender.pro>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crup/runrate.git"
  },
  "homepage": "https://github.com/crup/runrate#readme",
  "bugs": {
    "url": "https://github.com/crup/runrate/issues"
  },
  "bin": {
    "runrate": "./dist/cli.js"
  },
  "files": [
    "assets",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsup",
    "start": "pnpm build && node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "pnpm build && npm pack --dry-run"
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
